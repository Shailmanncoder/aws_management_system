{
  "name": "stratus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "worker:build": "node scripts/build-worker.mjs",
    "worker": "node --env-file-if-exists=.env dist/worker.mjs",
    "worker:dev": "npm run worker:build && node --env-file-if-exists=.env --enable-source-maps dist/worker.mjs",
    "check:source": "node scripts/check-source.mjs",
    "docs:gen": "tsx scripts/gen-docs.ts"
  },
  "dependencies": {
    "@aws-sdk/client-api-gateway": "3.1137.0",
    "@aws-sdk/client-apigatewayv2": "3.1137.0",
    "@aws-sdk/client-cloudfront": "3.1137.0",
    "@aws-sdk/client-cloudtrail": "3.1137.0",
    "@aws-sdk/client-cloudwatch": "3.1137.0",
    "@aws-sdk/client-cost-explorer": "3.1137.0",
    "@aws-sdk/client-dynamodb": "3.1137.0",
    "@aws-sdk/client-ec2": "3.1137.0",
    "@aws-sdk/client-ecr": "3.1137.0",
    "@aws-sdk/client-ecs": "3.1137.0",
    "@aws-sdk/client-eks": "3.1137.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "3.1137.0",
    "@aws-sdk/client-guardduty": "3.1137.0",
    "@aws-sdk/client-iam": "3.1137.0",
    "@aws-sdk/client-invoicing": "3.1137.0",
    "@aws-sdk/client-kms": "3.1137.0",
    "@aws-sdk/client-lambda": "3.1137.0",
    "@aws-sdk/client-pricing": "3.1137.0",
    "@aws-sdk/client-rds": "3.1137.0",
    "@aws-sdk/client-resource-explorer-2": "3.1137.0",
    "@aws-sdk/client-route-53": "3.1137.0",
    "@aws-sdk/client-s3": "3.1137.0",
    "@aws-sdk/client-s3-control": "3.1137.0",
    "@aws-sdk/client-securityhub": "3.1137.0",
    "@aws-sdk/client-sns": "3.1137.0",
    "@aws-sdk/client-sqs": "3.1137.0",
    "@aws-sdk/client-sts": "3.1137.0",
    "@aws-sdk/types": "3.974.5",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@smithy/types": "4.18.0",
    "better-auth": "1.7.5",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.3.2",
    "date-fns": "4.4.0",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^20",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "aws-sdk-client-mock": "4.1.0",
    "dotenv": "18.0.2",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jsdom": "30.1.1",
    "prisma": "7.10.0",
    "shadcn": "4.21.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true,
    "fsevents": false
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
