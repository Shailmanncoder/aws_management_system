# ─────────────────────────────────────────────────────────────────────────────
# Stratus environment template. PLACEHOLDERS ONLY — never commit real values.
# Copy to .env (git-ignored) and fill in. Validated at startup by src/server/env.ts.
# ─────────────────────────────────────────────────────────────────────────────

# development | test | production. Controls security-sensitive defaults.
APP_ENV=development
APP_URL=http://localhost:3000

# PostgreSQL. In production use TLS (sslmode=require / verify-full) and a least-privilege user.
DATABASE_URL=postgresql://stratus:stratus_local_dev_only@127.0.0.1:5432/stratus

# Better Auth session signing secret — >= 32 random bytes. Generate: openssl rand -base64 48
AUTH_SECRET=replace-me-with-a-long-random-value
# Optional OAuth providers (leave empty to disable)
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# Require email verification before sign-in (requires an email transport in production)
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# ── Encryption at rest (envelope encryption) ──
# "local": data keys wrapped by LOCAL_MASTER_KEY (dev/test only; rejected when APP_ENV=production)
# "kms":   data keys generated and wrapped by AWS KMS (KMS_KEY_ID)
ENCRYPTION_PROVIDER=local
# 32 random bytes, base64. Generate: openssl rand -base64 32
LOCAL_MASTER_KEY=
KMS_KEY_ID=
KMS_REGION=

# ── AWS integration ──
# "live": real AWS SDK calls. "fixtures": deterministic test fixtures (forbidden in production).
AWS_MODE=live
# The platform's own AWS account ID and the IAM principal customers trust in their role.
# The platform obtains its own credentials from the default provider chain (task role / instance profile).
PLATFORM_AWS_ACCOUNT_ID=
PLATFORM_AWS_PRINCIPAL_ARN=
# Region used for STS / global calls.
PLATFORM_AWS_REGION=us-east-1
# Access-key connections are for development only; disabled by default.
ALLOW_ACCESS_KEY_CONNECTIONS=false

# ── Jobs ──
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=3000
AWS_REGION_CONCURRENCY=4
AWS_SERVICE_CONCURRENCY=3
# Scheduled sync interval in minutes (0 disables the scheduler)
SCHEDULED_SYNC_INTERVAL_MINUTES=360

# ── Logging ──
LOG_LEVEL=info

# Number of trusted reverse proxies (ALB/CloudFront) in front of the app; used to derive client IPs.
TRUSTED_PROXY_HOPS=1
# Worker liveness endpoint port (0 disables)
WORKER_HEALTH_PORT=0

# Single-account self-hosting only: allow connecting the platform's own AWS account.
# Always false in production (rejected by env validation).
ALLOW_PLATFORM_ACCOUNT_CONNECTION=false
# Optional: named AWS CLI profile for the platform identity in local development
# (the SDK default provider chain reads it). Never use root credentials.
AWS_PROFILE=
